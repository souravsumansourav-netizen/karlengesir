# ============================================================
# Environment Variables Configuration
# ============================================================

# ─── Public Supabase Configuration (Client & Server) ────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Server-Only Supabase Service Role Key ──────────────────
# CRITICAL: Keep secret! Never prefix with NEXT_PUBLIC_
# Used by backend routes to bypass client-only RLS restrictions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Server-Only Backblaze B2 (S3-Compatible) Storage ───────
# Backblaze B2 Application Key ID (keyID)
B2_KEY_ID=004xxxxxxxxxxxx0000000001

# Backblaze B2 Application Key (applicationKey - shown only once upon creation)
B2_APPLICATION_KEY=K004xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backblaze B2 Private Bucket Name
B2_BUCKET=my-fileshare-bucket

# Backblaze B2 S3 Endpoint (from B2 Bucket Details, without https://)
# Example: s3.us-west-004.backblazeb2.com or s3.eu-central-003.backblazeb2.com
B2_ENDPOINT=s3.us-west-004.backblazeb2.com

# Backblaze B2 S3 Region (matches the region prefix of your endpoint)
# Example: us-west-004 or eu-central-003
B2_REGION=us-west-004

# ─── Storage Limits & Free-Tier Quota ───────────────────────
# Maximum single file upload limit in MB (default: 500 MB; supports 200 MB+)
MAX_FILE_SIZE_MB=500

# Total stored files quota in GB (default: 9.5 GB to keep within B2 10 GB free tier)
STORAGE_QUOTA_GB=9.5

# Storage Provider: "b2" (default) or "supabase" (stub)
STORAGE_PROVIDER=b2
