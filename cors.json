[
  {
    "corsRuleName": "AllowWebDirectUploadAndDownload",
    "allowedOrigins": [
      "http://localhost:3000",
      "https://YOUR-APP.vercel.app"
    ],
    "allowedHeaders": [
      "*"
    ],
    "allowedOperations": [
      "s3_put",
      "s3_get",
      "s3_head"
    ],
    "exposeHeaders": [
      "ETag"
    ],
    "maxAgeSeconds": 3600
  }
]
