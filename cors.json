[
  {
    "corsRuleName": "AllowWebDirectUploadAndDownload",
    "allowedOrigins": [
      "*"
    ],
    "allowedHeaders": [
      "*"
    ],
    "allowedOperations": [
      "s3_put",
      "s3_get",
      "s3_head",
      "s3_post",
      "s3_delete"
    ],
    "exposeHeaders": [
      "ETag",
      "x-amz-server-side-encryption"
    ],
    "maxAgeSeconds": 3600
  }
]
